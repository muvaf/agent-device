+test.each([
+  'retry deadline',
+  'short startup budget',
+  'admission timeout',
+  'caller cancellation',
+] as const)('a canceled run that keeps its slot handles %s', async (ending) => {
+  const options = { holdAdmission: true, canceledRunConflicts: 1000 };
+  const f = await fixture(options);
+  const controller = new AbortController();
+  const pending = f.runner
+    .createInteractor({ appBundleId: 'com.apple.Preferences', signal: controller.signal })
+    .snapshot();
+  const canceled = expect(pending).rejects.toThrow();
+  await vi.waitFor(() => expect(f.requests.some((p) => p.endsWith('/xctest/run'))).toBe(true));
+  controller.abort(new Error('stop cold launch'));
+  await canceled;
+  await vi.waitFor(() => expect(f.admissionClosed).toBe(true));
+  options.holdAdmission = false;
+  const timeout = new AbortController();
+  const realTimeout = AbortSignal.timeout.bind(AbortSignal);
+  const timer = vi
+    .spyOn(AbortSignal, 'timeout')
+    .mockImplementation((ms) => (ms === 90_000 ? timeout.signal : realTimeout(ms)));
+  let conflictRead!: () => void;
+  const conflict = new Promise<void>((resolve) => {
+    conflictRead = resolve;
+  });
+  const originalText = Response.prototype.text;
+  const responseBody = vi
+    .spyOn(Response.prototype, 'text')
+    .mockImplementation(async function (this: Response) {
+      const body = await originalText.call(this);
+      if (this.status === 409) conflictRead();
+      return body;
+    });
+  vi.useFakeTimers({ toFake: ['setTimeout', 'clearTimeout', 'Date'] });
+  try {
+    const restart = new AbortController();
+    const restarted = f.runner.applicationTools.prepareRunner(
+      f.device,
+      { execution: {}, timeoutMs: ending === 'short startup budget' ? 5_000 : 120_000 },
+      restart.signal,
+    );
+    let settled = false;
+    const outcome = restarted.then(
+      () => undefined,
+      (error: unknown) => error,
+    );
+    void outcome.then(() => {
+      settled = true;
+    });
+    await conflict;
+    // Let the launch continuation schedule its bounded retry after reading the response.
+    await vi.advanceTimersByTimeAsync(0);
+    if (ending === 'caller cancellation') restart.abort(new Error('stop retrying'));
+    else if (ending !== 'admission timeout') {
+      vi.setSystemTime(Date.now() + (ending === 'short startup budget' ? 2_501 : 60_001));
+      await vi.advanceTimersByTimeAsync(1_000);
+    }
+    if (ending === 'retry deadline' || ending === 'short startup budget') {
+      expect(settled).toBe(true);
+    }
+    timeout.abort(new DOMException('Admission expired', 'TimeoutError'));
+    if (ending === 'admission timeout') await vi.advanceTimersByTimeAsync(1_000);
+    expect(await outcome).toMatchObject(
+      ending === 'caller cancellation'
+        ? { details: { reason: 'request_canceled' } }
+        : {
+            code: 'COMMAND_FAILED',
+            details: {
+              reason: 'limrun_xctest_slot_occupied',
+              status: 409,
+              hint: expect.stringContaining('recreate'),
+            },
+          },
+    );
+    expect(f.requests.filter((p) => p.endsWith('/xctest/run')).length).toBeLessThan(90);
+  } finally {
+    timeout.abort(new DOMException('Admission expired', 'TimeoutError'));
+    vi.useRealTimers();
+    timer.mockRestore();
+    responseBody.mockRestore();
+  }
+});
+
